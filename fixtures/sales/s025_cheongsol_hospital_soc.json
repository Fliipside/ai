        {
          "id": "S025-I2-U05",
          "start": 47.9,
          "end": 56.0,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "원내에 수집 서버를 두고 분석 결과 요약만 관제센터로 보내는 방식으로 가능합니다.",
          "contact_id": null
