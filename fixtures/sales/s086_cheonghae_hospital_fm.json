        {
          "id": "S086-I1-U09",
          "start": 78.7,
          "end": 84.1,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "청소는 어떻게 되나요? 지금 미화는 다른 업체가 해요.",
          "contact_id": "S086-C1"
