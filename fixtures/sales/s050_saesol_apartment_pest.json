        {
          "id": "S050-I1-U05",
          "start": 62.8,
          "end": 70.0,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "약제 안전성 자료와 방역업 신고증을 다음 주 금요일까지 보내드리겠습니다.",
          "contact_id": null
        }
      ]
