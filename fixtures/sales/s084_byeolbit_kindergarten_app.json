        {
          "id": "S084-I3-U09",
          "start": 72.8,
          "end": 78.7,
          "speaker": "SPEAKER_03",
          "role": "customer",
          "text": "내년 2월 15일까지 설치하고 교사 교육도 두 번 해주세요.",
