        {
          "id": "S032-I2-U07",
          "start": 69.1,
          "end": 76.5,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "시범으로 한 달만 먼저 달아 보면 안 됩니껴? 치매 어르신 방 열 대로예.",
          "contact_id": "S032-C2"
