          "start": 24.8,
          "end": 32.2,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "그건 맞는 말이라예. 근데 와이파이가 방마다 잘 터져야 되는 거 아입니꺼?",
          "contact_id": "S032-C2"
