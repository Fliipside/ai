        {
          "id": "S004-I2-U01",
          "start": 13.9,
          "end": 20.1,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "아, 그러시군요. 혹시 담당이 바뀌면 누구랑 이어가면 될까요?",
          "contact_id": null
