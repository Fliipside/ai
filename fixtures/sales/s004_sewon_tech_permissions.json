        {
          "id": "S004-I2-U03",
          "start": 30.2,
          "end": 38.9,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "예산은 12월 본부장 회의에서 확정되니까, 그 전에 효과를 보여줄 수 있으면 좋겠어요.",
          "contact_id": "S004-C1"
        }
      ]
    },
