        {
          "id": "S095-I2-U05",
          "start": 44.5,
          "end": 56.2,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "9만 8천 원까지 맞춰보겠습니다. 제작이 4주라서, 11월 20일 입고하려면 10월 20일에는 발주가 들어와야 해요.",
          "contact_id": null
