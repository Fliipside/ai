          "start": 56.8,
          "end": 62.9,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "알겠어요. 사이즈 조사표는 이번엔 진짜 9월 말까지 드릴게요.",
          "contact_id": "S095-C1"
