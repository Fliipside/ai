      "kind": "call",
      "occurred_at": "2026-10-06T18:00:00+09:00",
      "title": "운영이사 비공개 통화: 평가 결과와 단가",
      "owner_user_id": 16,
      "visibility": "private",
      "participant_contact_ids": [
