        {
          "id": "S097-I1-U06",
          "start": 48.9,
          "end": 57.9,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "2천만 원 넘으면 입찰이라, 총액이 2,520만 원쯤 돼서 소액 입찰로 갈 가능성이 커요.",
          "contact_id": "S097-C1"
