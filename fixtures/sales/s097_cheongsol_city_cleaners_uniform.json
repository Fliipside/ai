        {
          "id": "S097-I1-U07",
          "start": 58.5,
          "end": 66.1,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "그러면 직접생산확인서 사본이랑 규격서를 다음 주 화요일까지 보내드리겠습니다.",
          "contact_id": null
