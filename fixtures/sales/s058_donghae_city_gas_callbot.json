        {
          "id": "S058-I1-U02",
          "start": 16.5,
          "end": 26.4,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "평소 하루 1,500통인데 12월 한파 오면 4,000통까지 올라가요. 대기 시간이 15분 넘어요.",
          "contact_id": "S058-C1"
        },
        {
          "id": "S058-I1-U03",
          "start": 27.0,
          "end": 29.0,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "어떤 문의가 많나요?",
          "contact_id": null
