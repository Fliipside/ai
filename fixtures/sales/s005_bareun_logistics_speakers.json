          "start": 91.9,
          "end": 99.5,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "장당 과금이고, 하루 1,500장 기준이면 월 150만 원 정도 예상됩니다.",
          "contact_id": null
