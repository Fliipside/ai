        {
          "id": "S070-I1-U01",
          "start": 16.5,
          "end": 22.3,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "지사 직원이 몇 분이고 예산은 어느 정도로 잡혀 있으세요?",
          "contact_id": null
