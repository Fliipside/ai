          "start": 13.6,
          "end": 17.9,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "점심 피크 때 대기 줄이 제일 문제시겠네요.",
          "contact_id": null
        },
        {
          "id": "S021-I1-U02",
          "start": 18.5,
          "end": 26.6,
          "speaker": "SPEAKER_02",
          "role": "customer",
