        {
          "id": "S043-I1-U07",
          "start": 68.5,
          "end": 76.2,
          "speaker": "SPEAKER_02",
          "role": "customer",
          "text": "다만 공고가 나가면 업체와 접촉이 제한되니 그 전에 필요한 건 말씀해 주세요.",
          "contact_id": "S043-C2"
        }
      ]
    },
