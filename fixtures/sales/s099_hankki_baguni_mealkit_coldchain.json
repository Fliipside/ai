        {
          "id": "S099-I3-U06",
          "start": 52.1,
          "end": 56.1,
          "speaker": "SPEAKER_02",
          "role": "customer",
          "text": "알겠습니다. 10월 30일까지 보낼게요.",
          "contact_id": "S099-C1"
