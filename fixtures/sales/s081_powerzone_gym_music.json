        {
          "id": "S081-I1-U12",
          "start": 93.3,
          "end": 97.4,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "5만 5천? 뭐 싸네. 일단 견적 줘봐요.",
          "contact_id": "S081-C1"
        }
      ]
    },
    {
