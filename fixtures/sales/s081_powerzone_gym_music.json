        {
          "id": "S081-I2-U10",
          "start": 82.3,
          "end": 88.1,
          "speaker": "SPEAKER_00",
          "role": "me",
          "text": "6개월은 월 요금이 올라서 지점당 6만 5천 원이 됩니다.",
          "contact_id": null
