          "id": "S081-I2-U09",
          "start": 78.5,
          "end": 81.7,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "1년은 길어. 6개월은 안 되나?",
          "contact_id": "S081-C1"
