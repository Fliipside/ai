          "end": 21.1,
          "speaker": "SPEAKER_01",
          "role": "customer",
          "text": "아직 협의회가 한 번도 안 열려가 의견을 못 모았어예. 11월은 돼야 될 것 같아예.",
          "contact_id": "S015-C1"
