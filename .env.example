APP_NAME=Flipside AI
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
DIARIZATION_ENGINE=pyannote
HF_TOKEN=
# PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
# PYANNOTE_SEGMENTATION_STEP=0.5
# Hugging Face model download location (default: ~/.cache/huggingface/hub)
# HF_HUB_CACHE=
SHERPA_SEGMENTATION_MODEL=
SHERPA_EMBEDDING_MODEL=
# SHERPA_CLUSTER_THRESHOLD=0.5
# SHERPA_NUM_THREADS=4
# VOICE_MATCH_THRESHOLD=0.5
# VOICE_MAX_AUDIO_SECONDS=3600
# VOICE_ENROLL_MIN_SECONDS=5
# VOICE_BUSY_RETRY_SECONDS=60
# VOICE_PRELOAD_MODELS=false
# VOICE_MATCH_THRESHOLD=
# Sentence-transformers model for conversation memory search (default: BAAI/bge-m3)
# TEXT_EMBEDDING_MODEL=
# Cross-encoder that reorders the top search results (default: BAAI/bge-reranker-v2-m3)
# RERANK_MODEL=
# LLM gateway (OpenAI-compatible) for key information extraction. Team shared key, never commit it.
LLM_API_KEY=
# LLM_BASE_URL=https://gateway.aitestbed.kr/v1
# LLM_MODEL=claude-sonnet-5-5
# LLM_REASONING_EFFORT=low
# DB for scripts/retrieval_eval.py --backend pg (via SSH tunnel). Loading needs no password.
# MEMORY_DB_URL=postgresql://<user>:<password>@localhost:15432/<db>

